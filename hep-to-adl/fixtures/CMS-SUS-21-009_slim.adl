# Slimmed fixture adapted from CMS-SUS-21-009 Delphes ADL (plugin golden).
# Not a complete analysis. Commented source cuts stay as # TODO, not invented selects.
# Full-scale CMS files live in the repo at examples/CMS/, not in this plugin.

#info analysis
#  title "Search for new physics in multijet events with at least one photon and large missing transverse momentum in proton-proton collisions at 13 TeV"
#  experiment CMS
#  id SUS-21-009
#  sqrtS 13.0
#  lumi 137

#info adl
#  adlauthor Sezen Sekmen
#  datatier Delphes

# Efficiency table trimmed to two rows so the keyword is visible.
# The source table is much longer; do not invent the missing bins.
table btagdeepCSVmedium
  tabletype efficiency
  nvars 1
  errors true
  # val    err-     err+     pTmin     pTmax
  0.5790   0.0016   0.0016    -10.4     30.0
  0.6314   0.0013   0.0013     30.0     35.0
# TODO: remaining btagdeepCSVmedium bins -- slimmed out of this fixture; see source analysis

# OBJECT SELECTION

object photons
  take Photon
  # TODO: photon ID -- source comments POGcutbasedlooseID == 1
  # TODO: photon isolation -- chargedhadsumdR03 / photonsumdR03 / neutralhadsumdR03 not given as a closed expression
  select pT(Photon) > 100
  select abs(Eta(Photon)) < 2.4
  reject abs(Eta(Photon)) [] 1.44 1.56

object AK4jets
  take Jet
  select pT(Jet) > 30
  select abs(eta(Jet)) < 2.4
  # TODO: jet ID -- source comments loosejetID == 1
  reject dR(Jet, photons) < 0.3

object bjets
  take AK4jets
  select abs(flavor(AK4jets)) == 5
  select applyHM( btagdeepCSVmedium( Pt(AK4jets) ) == 1)

object AK8jets
  take Jet
  select pT(FJet) > 200
  select abs(eta(FJet)) < 2.4
  # TODO: AK8 jet ID -- source comments loosejetID == 1

object heavyAK8jets
  take AK8jets
  select m(AK8jets) [] 65 140

object vetomuons
  take Muon
  select pT(Muon) > 10
  select abs(Eta(Muon)) < 2.4
  select miniIso(Muon) < 0.2
  # TODO: muon ID -- source comments POGmediummuonID == 1
  select dxy(Muon) < 0.2
  select dz(Muon) < 0.5

object vetoelectrons
  take Electron
  select pT(Electron) > 10
  select abs(eta(Electron)) < 2.5
  # TODO: electron ID -- source comments POGcutbasedVetoID == 1
  select miniIso(Electron) < 0.1
  select abs(eta(Electron)) < 1.479 ? dxy(Electron) < 0.05 : dxy(Electron) < 0.1
  select abs(eta(Electron)) < 1.479 ? dz(Electron) < 0.1 : dz(Electron) < 0.2

# EVENT VARIABLES
define ST = pT(photons[0]) + sum(pT(AK4jets))

# EVENT SELECTION

region baseline
  select size(photons) >= 1
  select MET > 300
  select size(AK4jets) >= 2
  select ST > 300
  # TODO: trigger -- source comments HLTMETHT
  select size(vetoelectrons) + size(vetomuons) == 0
  select dR(AK4jets[0:1], METLV[0]) > 0.3

region EWSRs
  baseline
  select size(AK4jets) [] 2 6
  select size(AK8jets) >= 1
  select m(AK8jets[0]) [] 65 140
  bin "35" m(AK8jets[0]) [] 65 105 and MET [] 300 370
  bin "36" m(AK8jets[0]) [] 65 105 and MET [] 370 450
# TODO: remaining EWSRs / SPSRs bins -- slimmed; see examples/CMS and the source ADL
