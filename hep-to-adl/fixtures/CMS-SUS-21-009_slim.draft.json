  "info": {
    "title": "Search for new physics in multijet events with at least one photon and large missing transverse momentum in proton-proton collisions at 13 TeV",
    "experiment": "CMS",
    "id": "SUS-21-009",
    "sqrtS": 13.0,
    "lumi": 137,
    "datatier": "Delphes"
  },
  "objects": [
    {
      "name": "photons",
      "take": "Photon",
      "selects": ["pT(Photon) > 100", "abs(Eta(Photon)) < 2.4"],
      "rejects": ["abs(Eta(Photon)) [] 1.44 1.56"],
      "notes": "ID and isolation are unresolved comments in the source."
    },
    {
      "name": "AK4jets",
      "take": "Jet",
      "selects": ["pT(Jet) > 30", "abs(eta(Jet)) < 2.4"],
      "rejects": ["dR(Jet, photons) < 0.3"]
    },
    {
      "name": "bjets",
      "take": "AK4jets",
      "selects": [
        "abs(flavor(AK4jets)) == 5",
        "applyHM( btagdeepCSVmedium( Pt(AK4jets) ) == 1)"
      ],
      "rejects": []
    },
    {
      "name": "AK8jets",
      "take": "Jet",
      "selects": ["pT(FJet) > 200", "abs(eta(FJet)) < 2.4"],
      "rejects": []
    },
    {
      "name": "heavyAK8jets",
      "take": "AK8jets",
      "selects": ["m(AK8jets) [] 65 140"],
      "rejects": []
    },
    {
      "name": "vetomuons",
      "take": "Muon",
      "selects": [
        "pT(Muon) > 10",
        "abs(Eta(Muon)) < 2.4",
        "miniIso(Muon) < 0.2",
        "dxy(Muon) < 0.2",
        "dz(Muon) < 0.5"
      ],
      "rejects": []
    },
    {
      "name": "vetoelectrons",
      "take": "Electron",
      "selects": [
        "pT(Electron) > 10",
        "abs(eta(Electron)) < 2.5",
        "miniIso(Electron) < 0.1",
        "abs(eta(Electron)) < 1.479 ? dxy(Electron) < 0.05 : dxy(Electron) < 0.1",
        "abs(eta(Electron)) < 1.479 ? dz(Electron) < 0.1 : dz(Electron) < 0.2"
      ],
      "rejects": []
    }
  ],
  "regions": [
    {
      "name": "baseline",
      "parents": [],
      "selects": [
        "size(photons) >= 1",
        "MET > 300",
        "size(AK4jets) >= 2",
        "ST > 300",
        "size(vetoelectrons) + size(vetomuons) == 0",
        "dR(AK4jets[0:1], METLV[0]) > 0.3"
      ],
      "notes": "Track vetoes and HLTMETHT omitted; see unresolved."
    },
    {
      "name": "EWSRs",
      "parents": ["baseline"],
      "selects": [
        "size(AK4jets) [] 2 6",
        "size(AK8jets) >= 1",
        "m(AK8jets[0]) [] 65 140"
      ],
      "notes": "Only two example bins kept in the slim ADL."
    }
  ],
  "defines": [
    {
      "name": "ST",
      "expr": "pT(photons[0]) + sum(pT(AK4jets))"
    }
  ],
  "tables": [
